<script>
  (function () {
    var d = document.querySelector('[data-sb-acct]');
    if (!d) return;
    function close() { d.open = false; }
    d.querySelector('[data-sb-acct-close]').addEventListener('click', close);
    document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && d.open) { close(); d.querySelector('summary').focus(); } });
    d.addEventListener('toggle', function () {
      if (d.open) { var r = d.getBoundingClientRect(); document.documentElement.style.setProperty('--header-bottom', (r.bottom + 12) + 'px'); }
    });
  })();
</script>
