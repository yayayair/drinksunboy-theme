{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "faq-goods": {
      "type": "sb-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How much is shipping?",
            "answer": "<p>Free on orders over $50. Under that, you'll see the shipping cost at checkout before you pay a cent.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>We pack it up at our warehouse and send it your way. You'll get a tracking link as soon as it's on the move.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Does the cooler come with SUNBOY in it?",
            "answer": "<p>We wish. We can't ship the drinks, but we can tell you exactly where to fill it. <a href=\"/pages/find-us\">Find SUNBOY near you</a>.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Will this make me cooler?",
            "answer": "<p>Statistically, yes.* <br><em>*Not a real statistic.</em></p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Can I return it?",
            "answer": "<p>Of course. Check our <a href=\"/policies/refund-policy\">refund policy</a> for the details.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ],
      "settings": {
        "show_on": "goods",
        "color_scheme": "scheme-5",
        "eyebrow": "Good questions",
        "heading": "Asked & answered",
        "intro": ""
      }
    }
  },
  "order": [
    "main",
    "faq-goods",
    "disclosures",
    "related-products"
  ]
}
