{%- liquid
  assign items = section.blocks
-%}
<div class="sb-marquee color-{{ section.settings.color_scheme }} gradient" style="--sb-speed: {{ section.settings.speed }}s;" role="region" aria-label="{{ section.settings.label | escape }}">
  <div class="sb-marquee__track">
    {%- for pass in (1..2) -%}
      {%- for i in (1..3) -%}
        {%- for block in items -%}
          {%- if block.settings.link != blank -%}
            <a class="sb-marquee__item" href="{{ block.settings.link }}" {% if pass > 1 or i > 1 %}aria-hidden="true" tabindex="-1"{% endif %} {{ block.shopify_attributes }}>{% render 'sb-sun' %}{{ block.settings.text }}</a>
          {%- else -%}
            <span class="sb-marquee__item" {% if pass > 1 or i > 1 %}aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>{% render 'sb-sun' %}{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SUNBOY scrolling bar",
  "class": "sb-section-marquee",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" },
    { "type": "range", "id": "speed", "label": "Seconds per loop (higher = slower)", "min": 10, "max": 120, "step": 5, "default": 45 },
    { "type": "text", "id": "label", "label": "Accessibility label", "default": "Announcements" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "The world's first spiked coconut water" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SUNBOY scrolling bar",
      "blocks": [
        { "type": "message", "settings": { "text": "The world's first spiked coconut water" } },
        { "type": "message", "settings": { "text": "Flip before you sip" } }
      ]
    }
  ]
}
{% endschema %}
