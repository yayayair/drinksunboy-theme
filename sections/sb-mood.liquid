{%- comment -%}
  Editorial image tiles. Pick 1–4 images; set how many sit side by side on desktop.
  Swap a photo: click the tile in the theme editor → Image → Select.
{%- endcomment -%}
{%- liquid
  assign cols = section.settings.columns | plus: 0
  if section.blocks.size < cols
    assign cols = section.blocks.size
  endif
  case cols
    when 1
      assign sizes = '100vw'
    when 2
      assign sizes = '(min-width: 750px) 50vw, 100vw'
    when 3
      assign sizes = '(min-width: 750px) 33vw, 100vw'
    else
      assign sizes = '(min-width: 750px) 25vw, 100vw'
  endcase
-%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="sb-mood sb-mood--cols-{{ cols }}{% unless section.settings.gap %} sb-mood--nogap{% endunless %}" style="--sb-cols: {{ cols }}; --sb-ratio: {{ section.settings.ratio }};">
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}
      {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }} class="sb-mood__tile" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} style="--sb-focus: {{ block.settings.focus }};" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {%- if section.index == 1 and forloop.index <= 2 -%}
            {{ block.settings.image | image_url: width: 2048 | image_tag: sizes: sizes, widths: '750, 1000, 1400, 1800, 2048', fetchpriority: 'high', loading: 'eager', alt: block.settings.image.alt }}
          {%- else -%}
            {{ block.settings.image | image_url: width: 2048 | image_tag: sizes: sizes, widths: '750, 1000, 1400, 1800, 2048', loading: 'lazy', alt: block.settings.image.alt }}
          {%- endif -%}
        {%- elsif block.settings.fallback != blank -%}
          <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- endif -%}
        <div class="sb-mood__caption">
          {%- if block.settings.eyebrow != blank -%}<p class="sb-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          {%- if block.settings.title != blank -%}<h2 class="sb-mood__title">{{ block.settings.title }}</h2>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<span class="sb-link-arrow">{{ block.settings.link_label }}</span>{%- endif -%}
        </div>
      </{{ tag }}>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SUNBOY image tiles",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "columns", "label": "Tiles side by side (desktop)", "default": "2",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "select", "id": "ratio", "label": "Tile shape (desktop)", "default": "4 / 5",
      "options": [ { "value": "4 / 5", "label": "Portrait" }, { "value": "1 / 1", "label": "Square" }, { "value": "16 / 9", "label": "Wide" }, { "value": "21 / 9", "label": "Extra wide" } ] },
    { "type": "checkbox", "id": "gap", "label": "Thin gap between tiles", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Use photos at least 2000px on the long side." },
        { "type": "select", "id": "focus", "label": "Keep in frame", "default": "center",
          "options": [ { "value": "center", "label": "Middle" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
        { "type": "text", "id": "eyebrow", "label": "Small label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "link_label", "label": "Link text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "fallback", "label": "Fallback theme image", "info": "Only used when no image is picked." }
      ]
    }
  ],
  "presets": [ { "name": "SUNBOY image tiles", "blocks": [ { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
