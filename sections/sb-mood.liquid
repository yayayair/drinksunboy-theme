{%- comment -%}
  Editorial image tiles (1-3 across). Each tile: image, eyebrow, title, link.
  If no image is picked, the tile falls back to a theme file (Fallback image).
{%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="sb-mood{% if section.settings.gap %} sb-mood--gap{% endif %}" style="--sb-cols: {{ section.blocks.size | at_most: 3 }}; --sb-ratio: {{ section.settings.ratio }};">
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}
      {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }} class="sb-mood__tile" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {%- if forloop.first -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600, 2000, 2400', fetchpriority: 'high', alt: block.settings.title }}
          {%- else -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600, 2000, 2400', loading: 'lazy', alt: block.settings.title }}
          {%- endif -%}
        {%- elsif block.settings.fallback != blank -%}
          <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" {% unless forloop.first %}loading="lazy"{% endunless %}>
        {%- endif -%}
        <div class="sb-mood__caption">
          {%- if block.settings.eyebrow != blank -%}<p class="sb-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          {%- if block.settings.title != blank -%}<h2 class="sb-mood__title">{{ block.settings.title }}</h2>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<span class="sb-link-arrow">{{ block.settings.link_label }}</span>{%- endif -%}
        </div>
      </{{ tag }}>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SUNBOY image tiles",
  "max_blocks": 3,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    {
      "type": "select", "id": "ratio", "label": "Desktop tile shape", "default": "4 / 5",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "16 / 9", "label": "Wide" },
        { "value": "21 / 9", "label": "Extra wide" }
      ]
    },
    { "type": "checkbox", "id": "gap", "label": "Small gap between tiles", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Small label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "link_label", "label": "Link text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "fallback", "label": "Fallback theme image", "info": "Used only when no image is picked above." }
      ]
    }
  ],
  "presets": [
    { "name": "SUNBOY image tiles", "blocks": [ { "type": "tile" }, { "type": "tile" } ] }
  ]
}
{% endschema %}
