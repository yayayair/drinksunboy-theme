{%- comment -%}
  Flavor lineup. Each block picks a flavor product; colours and hero line come from the
  product's SUNBOY metafields. On a flavor page, the current flavor is skipped.
{%- endcomment -%}
<section class="color-{{ section.settings.color_scheme }} gradient"{% if template.name == 'index' %} id="flavors"{% endif %}>
  <div class="sb-wrap sb-lineup">
    <div class="sb-lineup__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="sb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sb-display sb-lineup__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="sb-link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="sb-lineup__grid{% if template.name == 'product' %} sb-lineup__grid--rest{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign flavor = block.settings.product -%}
        {%- if flavor == blank -%}{%- continue -%}{%- endif -%}
        {%- if template.name == 'product' and flavor.id == product.id -%}{%- continue -%}{%- endif -%}
        <div {{ block.shopify_attributes }}>
          {% render 'sb-flavor-card', flavor: flavor, image: block.settings.image %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SUNBOY flavor lineup",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Seven flavors" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the lineup" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Find SUNBOY near you" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "settings": [
        { "type": "product", "id": "product", "label": "Flavor product" },
        { "type": "image_picker", "id": "image", "label": "Can image override", "info": "Transparent PNG/WebP of the can. Leave empty to use the built-in can art." }
      ]
    }
  ],
  "presets": [ { "name": "SUNBOY flavor lineup" } ]
}
{% endschema %}
