{%- comment -%}
  Flavor lineup. Each block picks a flavor page; colours and hero line come from the
  page's SUNBOY metafields. On a flavor page the current flavor is marked "You're here".
  On a non-flavor product page this section hides itself.
{%- endcomment -%}
{%- liquid
  assign show = true
  if template.name == 'product' and product.metafields.sunboy.hero_line == blank
    assign show = false
  endif
-%}
{%- if show -%}
<section class="color-{{ section.settings.color_scheme }} gradient" id="{{ section.settings.anchor | default: 'flavors' }}">
  <div class="sb-wrap sb-lineup">
    <div class="sb-lineup__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="sb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sb-display sb-lineup__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="sb-link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="sb-lineup__grid">
      {%- for block in section.blocks -%}
        {%- assign flavor = block.settings.flavor -%}
        {%- if flavor == blank -%}{%- continue -%}{%- endif -%}
        {%- assign is_current = false -%}
        {%- if template.suffix == 'flavor' and flavor.id == page.id -%}{%- assign is_current = true -%}{%- endif -%}
        <div {{ block.shopify_attributes }}>
          {% render 'sb-flavor-card', flavor: flavor, image: block.settings.image, current: is_current %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "SUNBOY flavor lineup",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "A hydrating coconut water with a splash of real fruit juice" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the lineup" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Find SUNBOY near you" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "anchor", "label": "Anchor (for links like /#flavors)", "default": "flavors" }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "settings": [
        { "type": "page", "id": "flavor", "label": "Flavor page" },
        { "type": "image_picker", "id": "image", "label": "Can image override", "info": "Transparent PNG of the can. Leave empty to use the Brand Kit can." }
      ]
    }
  ],
  "presets": [ { "name": "SUNBOY flavor lineup" } ]
}
{% endschema %}
