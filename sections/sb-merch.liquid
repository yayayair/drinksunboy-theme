<section class="color-{{ section.settings.color_scheme }} gradient">
  <div class="sb-wrap sb-goods">
    <div class="sb-lineup__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="sb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sb-display sb-lineup__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a class="sb-link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="sb-goods__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        {%- comment -%} Public merch only: skips internal-use items and anything not in the SUNBOY Goods collection. {%- endcomment -%}
        {%- assign sb_public = false -%}
        {%- for c in p.collections -%}{%- if c.handle == 'sunboy-swag' -%}{%- assign sb_public = true -%}{%- endif -%}{%- endfor -%}
        {%- if p.tags contains 'internal-use' or sb_public == false -%}{%- continue -%}{%- endif -%}
        <a class="sb-good" href="{{ p.url }}" {{ block.shopify_attributes }}>
          <div class="sb-good__img">
            {%- assign img = block.settings.image | default: p.featured_image -%}
            {%- if img != blank -%}{{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1200px) 25vw, 60vw', alt: p.title }}{%- endif -%}
          </div>
          <p class="sb-good__name">{{ p.title }}</p>
          <p class="sb-good__price">{% if p.available %}{{ p.price | money_without_trailing_zeros }}{% else %}Coming back soon{% endif %}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SUNBOY merch row",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "SUNBOY goods" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gear for golden hour" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link", "default": "/collections/sunboy-swag" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" }
      ]
    }
  ],
  "presets": [ { "name": "SUNBOY merch row" } ]
}
{% endschema %}

