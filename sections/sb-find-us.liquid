{%- comment -%}
  Find Us band. ZIP form → Find Us page (?zip=12345); "Use my location" → ?lat=..&lng=..
  Retailer blocks: logo + link to that retailer's SUNBOY page (opens in a new tab).
{%- endcomment -%}
{%- assign finder = section.settings.finder_url | default: '/pages/find-us' -%}
<section class="color-{{ section.settings.color_scheme }} gradient" id="find-us-{{ section.id }}">
  <div class="sb-wrap sb-find">
    {%- if section.settings.eyebrow != blank -%}<p class="sb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="sb-display sb-find__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="sb-find__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <form class="sb-find__form" action="{{ finder }}" method="get" role="search">
      {%- if template.name == 'page' and page.metafields.sunboy.hero_line != blank -%}<input type="hidden" name="flavor" value="{{ page.handle }}">{%- endif -%}
      <label class="visually-hidden" for="sb-zip-{{ section.id }}">ZIP code</label>
      <input class="sb-find__input" id="sb-zip-{{ section.id }}" name="zip" type="search" enterkeyhint="search" maxlength="160" autocomplete="postal-code" placeholder="{{ section.settings.placeholder | escape }}" required>
      <button class="sb-btn sb-btn--yellow" type="submit">{{ section.settings.button_label }}</button>
    </form>
    <button class="sb-find__geo" type="button" data-sb-geo="{{ finder }}">Use my location</button>

    {%- if section.blocks.size > 0 -%}
      {%- if section.settings.retail_label != blank -%}<p class="sb-eyebrow sb-find__retail-label">{{ section.settings.retail_label }}</p>{%- endif -%}
      <div class="sb-retailers">
        {%- for block in section.blocks -%}
          {%- if block.settings.logo == blank -%}{%- continue -%}{%- endif -%}
          {%- if block.settings.link != blank -%}
            <a class="sb-retailer" href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-label="SUNBOY at {{ block.settings.name | escape }} (opens in a new tab)" {{ block.shopify_attributes }}>
          {%- else -%}
            <span class="sb-retailer" {{ block.shopify_attributes }}>
          {%- endif -%}
            {{ block.settings.logo | image_url: width: 480 | image_tag: loading: 'lazy', alt: block.settings.name }}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
        {%- endfor -%}
        <p class="sb-retailers__names">
          {%- for block in section.blocks -%}
            {%- if block.settings.logo != blank -%}{%- continue -%}{%- endif -%}
            <span {{ block.shopify_attributes }}>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ block.settings.name }}</a>{%- else -%}{{ block.settings.name }}{%- endif -%}</span>
          {%- endfor -%}
        </p>
      </div>
    {%- endif -%}

    {%- if section.settings.art != blank -%}
      {{ section.settings.art | image_url: width: 500 | image_tag: class: 'sb-find__art', loading: 'lazy', alt: '' }}
    {%- elsif section.settings.art_fallback != blank -%}
      <img class="sb-find__art" src="{{ section.settings.art_fallback | asset_url }}" alt="" loading="lazy">
    {%- endif -%}
  </div>
</section>
<script>
  document.querySelectorAll('[data-sb-geo]').forEach(function (btn) {
    if (btn.dataset.bound) return; btn.dataset.bound = 1;
    if (!('geolocation' in navigator)) { btn.hidden = true; return; }
    btn.addEventListener('click', function () {
      btn.textContent = 'Finding you…';
      navigator.geolocation.getCurrentPosition(function (p) {
        var u = new URL(btn.dataset.sbGeo, location.origin);
        u.searchParams.set('lat', p.coords.latitude.toFixed(4));
        u.searchParams.set('lng', p.coords.longitude.toFixed(4));
        var f = btn.closest('section').querySelector('input[name="flavor"]');
        if (f) u.searchParams.set('flavor', f.value);
        location.href = u.toString();
      }, function () { btn.textContent = 'Use my location'; });
    });
  });
</script>

{% schema %}
{
  "name": "SUNBOY find us",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Thousands of stores nationwide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find SUNBOY" },
    { "type": "text", "id": "subheading", "label": "Text", "default": "Pop in your ZIP and we'll point you to the nearest cooler." },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "ZIP, city or address" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Search" },
    { "type": "url", "id": "finder_url", "label": "Find Us page" },
    { "type": "text", "id": "retail_label", "label": "Retailer row label", "default": "Or grab it at" },
    { "type": "image_picker", "id": "art", "label": "Illustration (optional)" },
    { "type": "text", "id": "art_fallback", "label": "Fallback theme image" }
  ],
  "blocks": [
    {
      "type": "retailer",
      "name": "Retailer",
      "settings": [
        { "type": "text", "id": "name", "label": "Retailer name", "default": "Retailer" },
        { "type": "image_picker", "id": "logo", "label": "Logo (optional)", "info": "Shown in white. Leave empty to show the name as text." },
        { "type": "url", "id": "link", "label": "Link to SUNBOY on their site (optional)" }
      ]
    }
  ],
  "presets": [ { "name": "SUNBOY find us" } ]
}
{% endschema %}
