{%- comment -%}
  SUNBOY store finder. Live data from VIP/SRS (stores that bought SUNBOY recently) via the
  sunboy-finder service on Vercel, plus store hours from Google. Map: Mapbox GL JS (light style recoloured to SUNBOY tones; public token in section settings).
  URL params: ?zip=10003 | ?lat=..&lng=..  &flavor=coconut  &miles=25  &type=on|off
{%- endcomment -%}
{{ 'https://api.mapbox.com/mapbox-gl-js/v3.8.0/mapbox-gl.css' | stylesheet_tag }}
<section class="sb-finder" id="sb-finder" data-api="{{ section.settings.api_base | default: 'https://sunboy-finder.vercel.app' }}" data-days="{{ section.settings.days }}" data-pack-classic="{{ 'sb-pack-classic-xs.webp' | asset_url }}" data-pack-refresher="{{ 'sb-pack-refresher-xs.webp' | asset_url }}" data-can="{{ 'sb-mini-can-coconut.webp' | asset_url }}" data-mapbox="{{ section.settings.mapbox_token | escape }}">
  <div class="sb-finder__top color-{{ section.settings.color_scheme }} gradient">
    <div class="sb-wrap">
      {%- if section.settings.eyebrow != blank -%}<p class="sb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="sb-display sb-finder__title">{{ section.settings.heading }}</h1>
      <form class="sb-finder__form" data-sb-finder-form>
        <label class="visually-hidden" for="sb-finder-zip">ZIP code, city or address</label>
        <input class="sb-find__input" id="sb-finder-zip" name="zip" type="search" enterkeyhint="search" maxlength="160" autocomplete="postal-code" placeholder="ZIP, city or address">
        <button class="sb-btn sb-btn--yellow" type="submit">Search</button>
        <button class="sb-finder__geo" type="button" data-sb-finder-geo>⌖ <span>Use my location</span></button>
      </form>
      <div class="sb-finder__filters">
        <div class="sb-finder__chips" role="radiogroup" aria-label="Flavor">
          <button type="button" class="sb-chip is-on" data-flavor="" role="radio" aria-checked="true">All flavors</button>
          {%- for block in section.blocks -%}
            {%- assign f = block.settings.flavor -%}
            {%- if f == blank -%}{%- continue -%}{%- endif -%}
            <button type="button" class="sb-chip" data-flavor="{{ f.handle | remove_first: 'sunboy-' }}" data-name="{{ f.title | capitalize | escape }}" role="radio" aria-checked="false" style="--chip: {{ f.metafields.sunboy.color_main.value | default: '#523B18' }}" {{ block.shopify_attributes }}>{{ f.title | capitalize }}</button>
          {%- endfor -%}
        </div>
        <div class="sb-finder__opts">
          <div class="sb-seg" role="radiogroup" aria-label="Type of spot">
            <button type="button" class="is-on" data-type="all" role="radio" aria-checked="true">All</button>
            <button type="button" data-type="off" role="radio" aria-checked="false">Stores <span>(take home)</span></button>
            <button type="button" data-type="on" role="radio" aria-checked="false">Bars &amp; restaurants</button>
          </div>
          <label>Within
            <select data-sb-miles>
              <option value="1">1 mile</option><option value="5">5 miles</option><option value="10">10 miles</option><option value="25" selected>25 miles</option><option value="50">50 miles</option>
            </select>
          </label>
        </div>
      </div>
    </div>
  </div>


  {%- comment -%} Mini controls: slide in under the header on desktop once the main controls scroll away. They drive the main controls. {%- endcomment -%}
  <div class="sb-minibar color-{{ section.settings.color_scheme }} gradient" data-sb-mini aria-hidden="true" inert>
    <div class="sb-minibar__inner">
      <span class="sb-minibar__label">Find SUNBOY</span>
      <form class="sb-minibar__form" data-mini-form>
        <input class="sb-find__input" name="zip" type="search" enterkeyhint="search" maxlength="160" placeholder="ZIP, city or address" aria-label="ZIP code, city or address">
        <button class="sb-btn sb-btn--yellow" type="submit">Search</button>
        <button class="sb-minibar__geo" type="button" data-mini-geo title="Use my location" aria-label="Use my location">⌖</button>
      </form>
      <div class="sb-minibar__chips">
        <button type="button" class="sb-chip is-on" data-mini-flavor="">All</button>
        {%- for block in section.blocks -%}
          {%- assign f = block.settings.flavor -%}
          {%- if f == blank -%}{%- continue -%}{%- endif -%}
          <button type="button" class="sb-chip" data-mini-flavor="{{ f.handle | remove_first: 'sunboy-' }}" style="--chip: {{ f.metafields.sunboy.color_main.value | default: '#523B18' }}">{{ f.title | capitalize }}</button>
        {%- endfor -%}
      </div>
      <div class="sb-seg sb-minibar__seg">
        <button type="button" class="is-on" data-mini-type="all">All</button>
        <button type="button" data-mini-type="off">Stores</button>
        <button type="button" data-mini-type="on">Bars</button>
      </div>
      <select class="sb-minibar__miles" data-mini-miles aria-label="Distance">
        <option value="1">1 mi</option><option value="5">5 mi</option><option value="10">10 mi</option><option value="25" selected>25 mi</option><option value="50">50 mi</option>
      </select>
    </div>
  </div>

  <div class="sb-finder__body" data-sb-body>
    <div class="sb-finder__status" data-sb-status aria-live="polite">{{ section.settings.intro }}</div>
    <div class="sb-finder__grid">
      <ol class="sb-finder__list" data-sb-list></ol>
      <div class="sb-finder__mapwrap" data-sb-mapwrap>
        <div class="sb-finder__map" data-sb-map></div>
        <div class="sb-finder__legend" aria-hidden="true"><span class="sb-key"></span>Stores <span class="sb-key sb-key--on"></span>Bars &amp; restaurants</div>
        <button type="button" class="sb-finder__fs" data-sb-fs aria-label="Full screen map"><span class="sb-fs-open">⤢ Full screen</span><span class="sb-fs-close">✕ Close</span></button>
        <p class="sb-finder__fsstatus" data-sb-fsstatus></p>
      </div>
    </div>
    <div class="sb-sheet" data-sb-peek hidden>
      <button type="button" class="sb-sheet__handle" data-sb-sheet-handle aria-label="Expand or close details"><span></span></button>
      <div class="sb-sheet__body" data-sb-sheet-body></div>
    </div>
    <button type="button" class="sb-finder__maptoggle sb-btn sb-btn--solid" data-sb-maptoggle hidden>List</button>
    <div class="sb-finder__online" data-sb-online hidden></div>
    <p class="sb-finder__note">{{ section.settings.note }}</p>
  </div>
</section>

<script src="https://api.mapbox.com/mapbox-gl-js/v3.8.0/mapbox-gl.js" defer></script>
<script>
(function () {
  var root = document.getElementById('sb-finder');
  var API = root.dataset.api.replace(/\/$/, ''), DAYS = parseInt(root.dataset.days || '60', 10);
  var form = root.querySelector('[data-sb-finder-form]'), zipEl = form.querySelector('[name=zip]');
  var geoBtn = root.querySelector('[data-sb-finder-geo]'), GEO_LABEL = geoBtn.innerHTML;
  var listEl = root.querySelector('[data-sb-list]'), statusEl = root.querySelector('[data-sb-status]');
  var milesEl = root.querySelector('[data-sb-miles]'), bodyEl = root.querySelector('[data-sb-body]');
  var onlineEl = root.querySelector('[data-sb-online]'), mapToggle = root.querySelector('[data-sb-maptoggle]');
  var peekEl = root.querySelector('[data-sb-peek]'), sheetBody = root.querySelector('[data-sb-sheet-body]');
  var fsBtn = root.querySelector('[data-sb-fs]'), fsStatus = root.querySelector('[data-sb-fsstatus]');
  var mobile = window.matchMedia('(max-width: 989px)');
  var state = { zip: '', q: '', lat: null, lng: null, flavor: '', miles: 25, type: 'all', data: null, stores: [], sel: null, area: 0, place: '', selKey: null, selStore: null, origin: null };
  var auto = false, autoT, moveT;
  var map, markers = {}, byKey = {}, hoursCache = {}, gnames = {};
  var params = new URLSearchParams(location.search);
  var COLORS = {}, NAMES = {};
  root.querySelectorAll('.sb-chip[data-flavor]').forEach(function (c) { if (c.dataset.flavor) { COLORS[c.dataset.flavor] = c.style.getPropertyValue('--chip'); NAMES[c.dataset.flavor] = c.dataset.name; } });

  // Phones open on the map
  if (mobile.matches) root.classList.add('show-map');

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function setStatus(t) { statusEl.innerHTML = t; fsStatus.innerHTML = t; }
  function group(sel, attr, val) {
    root.querySelectorAll(sel).forEach(function (c) { var on = c.dataset[attr] === val; c.classList.toggle('is-on', on); c.setAttribute('aria-checked', on); });
  }
  function syncUrl() {
    var p = new URLSearchParams();
    if (state.auto) {} // opening view near the visitor's approximate city: keep the URL clean
    else if (state.zip) p.set('zip', state.zip); else if (state.q) p.set('q', state.q); else if (state.lat !== null) { p.set('lat', state.lat.toFixed(4)); p.set('lng', state.lng.toFixed(4)); }
    if (state.flavor) p.set('flavor', state.flavor);
    if (state.area) p.set('miles', state.area); else if (state.miles !== 25) p.set('miles', state.miles);
    if (state.type !== 'all') p.set('type', state.type);
    history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p : '') + location.hash);
  }
  function mi(n) { return n + (n === 1 ? ' mile' : ' miles'); }
  // First letter of the spot's name for its pin ("The Belfry" → B, "124 Old Rabbit Club" → 1)
  function initial(n) { var m = String(n || '').replace(/^the\s+/i, '').match(/[a-z0-9]/i); return m ? m[0].toUpperCase() : ''; }
  function keyOf(s) { return (s.name + '|' + s.street).toLowerCase(); }
  function miles(a, b) {
    var R = 3958.8, t = Math.PI / 180, dLat = (b.lat - a.lat) * t, dLng = (b.lng - a.lng) * t;
    var x = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(a.lat * t) * Math.cos(b.lat * t) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
    return 2 * R * Math.asin(Math.sqrt(x));
  }

  function search(opts) {
    if (!state.zip && state.lat === null) { setStatus('Pop in your ZIP, city or address to see coolers near you.'); return; }
    syncUrl();
    var keep = !!(opts && opts.keepView);
    if (!keep) { state.selKey = null; state.selStore = null; }
    setStatus('<span class="sb-finder__spin"></span> Looking in every cooler near you…');
    if (opts && opts.scroll) bodyEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    var q = new URLSearchParams({ miles: state.area || state.miles, days: DAYS });
    if (state.zip) q.set('zip', state.zip); else { q.set('lat', state.lat); q.set('lng', state.lng); }
    if (state.flavor) q.set('flavor', state.flavor);
    if (state.type !== 'all') q.set('type', state.type);
    fetch(API + '/api/stores?' + q).then(function (r) { return r.json(); }).then(function (d) {
      if (d.error) { setStatus(esc(d.error)); return; }
      state.data = d; render(keep);
    }).catch(function () { setStatus('The store finder is taking a breather. Try again in a minute.'); });
  }

  function slugOf(b) { return b.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, ''); }
  function carries(s) {
    if (!s.brands || !s.brands.length) return '';
    var items = s.brands.slice().sort(function (a, b) { return /pack/i.test(a) - /pack/i.test(b) || a.localeCompare(b); }).map(function (b) {
      if (/classic/i.test(b)) return '<span class="sb-has sb-has--pack"><img src="' + root.dataset.packClassic + '" alt="" width="34" height="29" loading="lazy">Classic Variety 8pk</span>';
      if (/refresh/i.test(b)) return '<span class="sb-has sb-has--pack"><img src="' + root.dataset.packRefresher + '" alt="" width="34" height="29" loading="lazy">Refresher Variety 8pk</span>';
      var k = slugOf(b);
      if (NAMES[k]) return '<span class="sb-has sb-has--can"><img src="' + root.dataset.can.replace('sb-mini-can-coconut', 'sb-mini-can-' + k) + '" alt="" width="12" height="28" loading="lazy">' + esc(NAMES[k]) + '</span>';
      return '<span class="sb-has" style="--dot:' + esc(COLORS[k] || '#0BB89B') + '">' + esc(b) + '</span>';
    });
    var sizes = [];
    (s.packages || []).forEach(function (p) {
      var t = /SNGL|19\.2/i.test(p) ? '19.2oz cans' : /4PK/i.test(p) ? '4-packs' : /8PK/i.test(p) ? '8-packs' : '';
      if (t && sizes.indexOf(t) < 0) sizes.push(t);
    });
    if (sizes.join() === '8-packs' && s.brands.every(function (b) { return /pack/i.test(b); })) sizes = [];
    return '<p class="sb-store__has">' + items.join('') + '</p>' + (sizes.length ? '<p class="sb-store__sizes">In ' + sizes.join(', ') + '</p>' : '');
  }

  function card(s, i) {
    var addr = s.street + ', ' + s.city + ', ' + s.state + ' ' + s.zip;
    var stocked = s.daysAgo !== null && s.daysAgo <= 14 ? '<span class="sb-tag sb-tag--fresh">Recently stocked</span>' : '';
    var kind = '<span class="sb-tag">' + (s.onPremise ? 'Bar &amp; restaurant' : 'Store') + '</span>';
    var h = hoursCache[s.key];
    var dir = (h && h.mapsUrl) || 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(s.name + ', ' + addr);
    return '<div class="sb-store__dot' + (s.onPremise ? ' is-on' : '') + '"></div>' +
      '<div class="sb-store__main">' +
        '<h3 class="sb-store__name" data-name>' + esc(s.gname || s.name) + '</h3>' +
        '<p class="sb-store__addr"><a href="' + esc(dir) + '" target="_blank" rel="noopener" data-dir>' + esc(addr) + '</a></p>' +
        '<p class="sb-store__meta">' + (isFinite(s.distance) ? '<span class="sb-store__dist">' + (s.distance < 0.1 ? 'Right here' : s.distance.toFixed(1) + ' mi') + '</span>' : '') + kind + stocked + '</p>' +
        carries(s) +
        '<p class="sb-store__hours" data-hours>' + hoursLine(h) + '</p>' +
        '<p class="sb-store__actions"><a href="' + esc(dir) + '" target="_blank" rel="noopener" data-dir>Directions</a>' + (s.phone ? '<a href="tel:' + esc(s.phone.replace(/[^\d+]/g, '')) + '">Call</a>' : '') + '</p>' +
      '</div>';
  }

  function render(keepView) {
    var d = state.data; if (!d) return;
    var stores = d.stores.slice();
    stores.forEach(function (s) {
      s.key = keyOf(s); if (gnames[s.key]) s.gname = gnames[s.key];
      // distances stay measured from where you searched, even after the map moves
      if (state.origin) s.distance = miles(state.origin, s);
      else if (state.area) s.distance = NaN;
    });
    if (state.origin) stores.sort(function (a, b) { return a.distance - b.distance; });
    var count = stores.length;
    // a selected spot survives a refresh, even if the map moved away from it
    var selIdx = -1;
    if (state.selKey) {
      selIdx = stores.findIndex(function (s) { return s.key === state.selKey; });
      if (selIdx < 0 && state.selStore) { stores.push(state.selStore); selIdx = stores.length - 1; }
    }
    state.stores = stores; state.sel = selIdx < 0 ? null : selIdx;
    if (selIdx < 0) closeSheet();
    var flav = state.flavor ? (NAMES[state.flavor] || state.flavor) : 'SUNBOY';
    var kind = state.type === 'off' ? 'stores' : state.type === 'on' ? 'bars & restaurants' : 'spots';
    var where = state.area ? ' in this area' : ' within ' + mi(state.miles) + (state.place ? ' of ' + esc(state.place) : '');
    if (!count) {
      setStatus('No ' + esc(kind === 'spots' ? '' : kind + ' with ') + esc(flav) + where + ' yet. ' + (state.area ? 'Try zooming out' : 'Try a bigger radius') + (state.flavor ? ' or all flavors' : '') + '.');
    } else {
      setStatus('<b>' + count + (count === 60 ? '+' : '') + '</b> ' + esc(kind) + ' with ' + esc(flav) + where + (d.widened ? ' <span class="sb-finder__muted">(including spots that last stocked it a little while ago)</span>' : '') + '.' +
        (state.auto ? ' <span class="sb-finder__muted">Not where you are? Pop in your ZIP or use your location.</span>' : ''));
    }
    listEl.innerHTML = stores.map(function (s, i) { return '<li class="sb-store" id="store-' + i + '" data-i="' + i + '">' + card(s, i) + '</li>'; }).join('');
    online(d.online || []);
    drawMap(stores, keepView);
    watchHours();
    if (selIdx > -1) select(selIdx, 'restore');
  }

  function online(list) {
    if (!list.length) { onlineEl.hidden = true; return; }
    onlineEl.hidden = false;
    onlineEl.innerHTML = '<p class="sb-eyebrow">Or get it delivered</p>' + list.map(function (v) { return '<a class="sb-btn" href="' + esc(v.url) + '" target="_blank" rel="noopener">' + esc(v.name) + '</a>'; }).join('');
  }

  // Hours: fetched only when a card is seen (keeps Google costs tiny; cached for a day).
  function hoursLine(h) {
    if (!h) return '&nbsp;';
    if (h.closed) return 'May be closed. Call ahead.';
    var line = today(h); return line ? '<b>Today</b> ' + esc(line) : '';
  }
  function loadHours(i, done) {
    var s = state.stores[i]; if (!s) return;
    if (hoursCache[s.key]) { done(hoursCache[s.key]); return; }
    var q = new URLSearchParams({ name: s.name, address: s.street + ', ' + s.city + ', ' + s.state + ' ' + s.zip, lat: s.lat, lng: s.lng, v: 2 });
    fetch(API + '/api/hours?' + q).then(function (r) { return r.json(); }).then(function (h) {
      hoursCache[s.key] = h;
      if (h.name && sameStore(s.name, h.name)) s.gname = gnames[s.key] = h.name;
      done(h);
    }).catch(function () {});
  }
  // Google's listing name is usually the cleanest ("Craft + Carry" vs VIP's "CRAFT & CARRY R").
  // Only use it when most of the words match, so a wrong Google hit never renames a store.
  function words(n) {
    return String(n).toLowerCase().replace(/&|\+/g, ' and ').replace(/['’`.]/g, '').split(/[^a-z0-9]+/)
      .filter(function (w) { return w.length > 1 && !/^(the|and|of|at|store|inc|llc|nyc|ny|co|company|shop|market|deli|bar|restaurant)$/.test(w); });
  }
  function sameStore(a, b) {
    var A = words(a), B = words(b); if (!A.length || !B.length || b.length > 48) return false;
    var hit = A.filter(function (w) { return B.indexOf(w) > -1 || B.some(function (x) { return x.length > 3 && (x.indexOf(w) === 0 || w.indexOf(x) === 0); }); }).length;
    return hit / A.length > 0.5 && hit / B.length >= 0.5;
  }
  function paintHours(el, h) {
    var s = state.stores[el.dataset.i != null ? +el.dataset.i : state.sel], nm = el.querySelector('[data-name]');
    if (nm && s && s.gname) nm.textContent = s.gname;
    var hl = el.querySelector('[data-hours]'); if (hl) hl.innerHTML = hoursLine(h);
    if (h.mapsUrl) el.querySelectorAll('[data-dir]').forEach(function (a) { a.href = h.mapsUrl; });
  }
  var io;
  function watchHours() {
    if (io) io.disconnect();
    io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return; io.unobserve(e.target);
        loadHours(+e.target.dataset.i, function (h) { paintHours(e.target, h); });
      });
    }, { rootMargin: '200px' });
    listEl.querySelectorAll('.sb-store').forEach(function (li) { io.observe(li); });
  }
  function today(h) {
    if (!h.week || !h.week.length) return '';
    var now = new Date(), local = h.utcOffset != null ? new Date(now.getTime() + (h.utcOffset + now.getTimezoneOffset()) * 60000) : now;
    var name = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][local.getDay()];
    var line = h.week.find(function (l) { return l.indexOf(name) === 0; }) || '';
    return line.replace(name + ': ', '').replace(/ | /g, ' ');
  }

  // One selected spot at a time: its pin turns yellow and its card is outlined, whichever you tapped.
  // Bring a list card into view below the pinned header + mini search bar, never above the top of the list
  function scrollToCard(li) {
    var hw = document.querySelector('.header-wrapper'), mini = root.querySelector('[data-sb-mini]');
    var bars = (hw ? hw.getBoundingClientRect().bottom : 0) + (mini && window.matchMedia('(min-width: 990px)').matches ? mini.offsetHeight : 0) + 16;
    var r = li.getBoundingClientRect(), vh = window.innerHeight;
    if (r.top >= bars && r.bottom <= vh - 16) return; // already fully visible
    var listTop = listEl.getBoundingClientRect().top + window.scrollY - bars;
    var centred = r.top + window.scrollY - bars - Math.max(0, (vh - bars - r.height) / 2);
    window.scrollTo({ top: Math.max(listTop, centred), behavior: 'smooth' });
  }
  function select(i, from) {
    state.sel = i; state.selKey = state.stores[i].key; state.selStore = state.stores[i];
    root.querySelectorAll('.sb-pin.is-sel').forEach(function (p) { p.classList.remove('is-sel'); });
    listEl.querySelectorAll('.sb-store.is-sel').forEach(function (c) { c.classList.remove('is-sel'); });
    Object.keys(markers).forEach(function (k) { markers[k].getElement().style.zIndex = ''; });
    var m = markers[i], li = document.getElementById('store-' + i);
    if (m) { var el = m.getElement(); el.style.zIndex = 5; el.classList.add('is-sel'); }
    if (li) li.classList.add('is-sel');
    if (from === 'restore') {
      if (!peekEl.hidden) sheetBody.innerHTML = '<div class="sb-store is-sel" data-i="' + i + '">' + card(state.stores[i], i) + '</div>';
    } else if (from === 'pin') {
      if (root.classList.contains('show-map') && mobile.matches) {
        openSheet(i);
      } else if (li) {
        scrollToCard(li);
      }
    } else if (m && map) {
      var p = map.project(m.getLngLat()), box = map.getContainer();
      if (p.x < box.clientWidth * .1 || p.x > box.clientWidth * .9 || p.y < box.clientHeight * .1 || p.y > box.clientHeight * .9) { quiet(); map.panTo(m.getLngLat()); }
    }
  }

  // SUNBOY-toned map: cream land, soft teal water, white streets, brown labels, no POI/transit clutter.
  function brandMap() {
    (map.getStyle().layers || []).forEach(function (l) {
      var id = l.id, t = l.type;
      try {
        if (/poi|transit|airport|aeroway|ferry|aerialway|housenum|building-number/.test(id)) { map.setLayoutProperty(id, 'visibility', 'none'); return; }
        if (t === 'background') map.setPaintProperty(id, 'background-color', '#F6F0E4');
        else if (/water/.test(id) && t === 'fill') map.setPaintProperty(id, 'fill-color', '#BFE4DC');
        else if (/water/.test(id) && t === 'line') map.setPaintProperty(id, 'line-color', '#BFE4DC');
        else if (/park|national|landuse|pitch|golf|cemetery/.test(id) && t === 'fill') map.setPaintProperty(id, 'fill-color', '#E6ECD3');
        else if (/building/.test(id) && t === 'fill') { map.setPaintProperty(id, 'fill-color', '#EEE5D4'); map.setPaintProperty(id, 'fill-outline-color', '#E4D8C2'); }
        else if (/land/.test(id) && t === 'fill') map.setPaintProperty(id, 'fill-color', '#F6F0E4');
        else if (/road|street|bridge|tunnel|path/.test(id) && t === 'line') map.setPaintProperty(id, 'line-color', /case/.test(id) ? '#E9DDC7' : '#FFFFFF');
        else if (t === 'symbol') {
          map.setPaintProperty(id, 'text-color', /road|street/.test(id) ? '#9A8466' : '#6B5537');
          map.setPaintProperty(id, 'text-halo-color', '#F6F0E4');
        }
      } catch (e) {}
    });
  }
  function quiet() { auto = true; clearTimeout(autoT); autoT = setTimeout(function () { auto = false; }, 900); }
  // Search this area: when someone drags or zooms the map, look again around what they're looking at.
  function areaSearch() {
    var c = map.getCenter(), b = map.getBounds();
    var r = Math.ceil(c.distanceTo(b.getNorthEast()) / 1609.34);
    state.area = Math.max(1, Math.min(100, r));
    state.lat = c.lat; state.lng = c.lng; state.zip = ''; state.q = ''; state.place = ''; state.auto = false;
    search({ keepView: true });
  }
  function drawMap(stores, keepView) {
    if (!window.mapboxgl) { window.addEventListener('load', function () { drawMap(stores, keepView); }, { once: true }); return; }
    // the Mapbox public token comes from the finder service (or the section setting, if filled in)
    if (!root.dataset.mapbox) {
      if (!drawMap.waiting) {
        drawMap.waiting = true;
        fetch(API + '/api/config').then(function (r) { return r.json(); }).then(function (c) { root.dataset.mapbox = c.mapbox || ''; drawMap.waiting = false; if (root.dataset.mapbox) drawMap(state.stores, keepView); });
      }
      return;
    }
    var el = root.querySelector('[data-sb-map]');
    if (!map) {
      mapboxgl.accessToken = root.dataset.mapbox;
      quiet();
      map = new mapboxgl.Map({ container: el, style: 'mapbox://styles/mapbox/light-v11', center: [state.lng || -73.99, state.lat || 40.73], zoom: 12, scrollZoom: false, dragRotate: false, pitchWithRotate: false, touchPitch: false, cooperativeGestures: false, attributionControl: true });
      map.touchZoomRotate.disableRotation();
      map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-left');
      map.on('style.load', brandMap);
      map.on('click', function () { closeSheet(); });
      map.on('movestart', function () { clearTimeout(moveT); });
      map.on('moveend', function () { if (auto) return; clearTimeout(moveT); moveT = setTimeout(areaSearch, 700); });
    }
    // Pins that are still in view stay put; only new ones are added and gone ones removed.
    if (!keepView) { Object.keys(byKey).forEach(function (k) { byKey[k].remove(); }); byKey = {}; }
    var keep = {}, pts = [];
    markers = {};
    stores.forEach(function (s, i) {
      if (!isFinite(s.lat) || !isFinite(s.lng)) return;
      var m = byKey[s.key];
      if (!m) {
        var pin = document.createElement('button');
        pin.type = 'button'; pin.className = 'sb-pin' + (s.onPremise ? ' sb-pin--on' : '');
        pin.innerHTML = '<span>' + esc(initial(s.gname || s.name)) + '</span>';
        pin.title = s.gname || s.name; pin.setAttribute('aria-label', s.gname || s.name);
        (function (k) { pin.addEventListener('click', function (e) { e.stopPropagation(); var j = state.stores.findIndex(function (x) { return x.key === k; }); if (j > -1) select(j, 'pin'); }); })(s.key);
        m = byKey[s.key] = new mapboxgl.Marker({ element: pin }).setLngLat([s.lng, s.lat]).addTo(map);
      }
      keep[s.key] = 1; markers[i] = m; pts.push([s.lng, s.lat]);
    });
    Object.keys(byKey).forEach(function (k) { if (!keep[k]) { byKey[k].remove(); delete byKey[k]; } });
    map.resize();
    if (pts.length && !keepView) {
      var b = new mapboxgl.LngLatBounds(pts[0], pts[0]); pts.slice(0, 15).forEach(function (p) { b.extend(p); });
      quiet(); map.fitBounds(b, { padding: 40, maxZoom: 15, duration: 0 });
    } else if (!pts.length && !keepView && state.lat !== null) { quiet(); map.jumpTo({ center: [state.lng, state.lat], zoom: 12 }); }
    mapToggle.hidden = !pts.length;
  }
  listEl.addEventListener('click', function (e) {
    if (e.target.closest('a')) return;
    var li = e.target.closest('.sb-store'); if (li) select(+li.dataset.i, 'card');
  });
  listEl.addEventListener('mouseover', function (e) {
    var li = e.target.closest('.sb-store'); root.querySelectorAll('.sb-pin.is-hl').forEach(function (p) { p.classList.remove('is-hl'); });
    if (!li || !markers[li.dataset.i]) return;
    markers[li.dataset.i].getElement().classList.add('is-hl');
  });
  listEl.addEventListener('mouseleave', function () { root.querySelectorAll('.sb-pin.is-hl').forEach(function (p) { p.classList.remove('is-hl'); }); });
  function setView(showMap) {
    root.classList.toggle('show-map', showMap); mapToggle.textContent = showMap ? 'List' : 'Map';
    if (!showMap) { closeSheet(); setFull(false); }
    if (map) setTimeout(function () { quiet(); map.resize(); }, 50);
  }
  // Phone: details slide up from the bottom when a pin is tapped. Drag the handle up for more, down to close.
  function openSheet(i) {
    sheetBody.innerHTML = '<div class="sb-store is-sel" data-i="' + i + '">' + card(state.stores[i], i) + '</div>';
    peekEl.hidden = false; peekEl.classList.remove('is-tall');
    requestAnimationFrame(function () { root.classList.add('has-sheet'); });
    // keep the tapped pin visible above the card
    setTimeout(function () {
      var m = markers[i]; if (!m || !map) return;
      var pt = map.project(m.getLngLat()), mh = map.getContainer().clientHeight;
      var r = map.getContainer().getBoundingClientRect(), visible = Math.min(mh, peekEl.getBoundingClientRect().top - r.top);
      if (pt.y > visible - 40 || pt.y < 40) { quiet(); map.panBy([0, pt.y - visible / 2]); }
    }, 280);
    loadHours(i, function (h) { if (state.sel === i) paintHours(sheetBody, h); });
  }
  function closeSheet() {
    if (peekEl.hidden) return;
    root.classList.remove('has-sheet'); peekEl.classList.remove('is-tall');
    setTimeout(function () { if (!root.classList.contains('has-sheet')) peekEl.hidden = true; }, 260);
    root.querySelectorAll('.sb-pin.is-sel').forEach(function (p) { p.classList.remove('is-sel'); });
    listEl.querySelectorAll('.sb-store.is-sel').forEach(function (c) { c.classList.remove('is-sel'); });
    state.sel = null; state.selKey = null; state.selStore = null;
  }
  var y0 = null;
  peekEl.addEventListener('touchstart', function (e) { y0 = e.touches[0].clientY; }, { passive: true });
  peekEl.addEventListener('touchend', function (e) {
    if (y0 === null) return; var dy = e.changedTouches[0].clientY - y0; y0 = null;
    if (dy < -40) peekEl.classList.add('is-tall');
    else if (dy > 50) { if (peekEl.classList.contains('is-tall') && sheetBody.scrollTop <= 0) peekEl.classList.remove('is-tall'); else if (sheetBody.scrollTop <= 0) closeSheet(); }
  });
  root.querySelector('[data-sb-sheet-handle]').addEventListener('click', function () { peekEl.classList.toggle('is-tall'); });

  // Phone: full-screen map you can toggle in and out of.
  function setFull(on) {
    root.classList.toggle('is-full', on);
    document.documentElement.classList.toggle('sb-noscroll', on);
    if (map) setTimeout(function () { quiet(); map.resize(); }, 60);
  }
  fsBtn.addEventListener('click', function () { setFull(!root.classList.contains('is-full')); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && root.classList.contains('is-full')) setFull(false); });

  mapToggle.addEventListener('click', function () { setView(!root.classList.contains('show-map')); });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    zipEl.blur();
    lookup(zipEl.value.trim(), { scroll: mobile.matches });
  });
  // A 5-digit ZIP goes straight to the finder; anything else (city, neighborhood, street address) is looked up first.
  function lookup(v, opts) {
    state.auto = false;
    state.area = 0;
    if (/^\d{5}$/.test(v)) {
      state.zip = v; state.q = ''; state.place = ''; state.lat = state.lng = null; state.origin = null; search(opts);
      fetch(API + '/api/geocode?' + new URLSearchParams({ q: v })).then(function (r) { return r.json(); }).then(function (g) { if (isFinite(g.lat) && state.zip === v) state.origin = { lat: g.lat, lng: g.lng }; }).catch(function () {});
      return;
    }
    if (v.length < 2) { setStatus('Type a ZIP, city or address.'); return; }
    setStatus('<span class="sb-finder__spin"></span> Finding ' + esc(v) + '…');
    fetch(API + '/api/geocode?' + new URLSearchParams({ q: v })).then(function (r) { return r.json(); }).then(function (g) {
      if (g.error || !isFinite(g.lat)) { setStatus(esc(g.error || 'We couldn’t find that place. Try a ZIP.')); return; }
      state.zip = ''; state.q = v; state.place = g.label || v; state.lat = g.lat; state.lng = g.lng; state.origin = { lat: g.lat, lng: g.lng };
      search(opts);
    }).catch(function () { setStatus('Search is taking a breather. Try your ZIP.'); });
  }

  // Use my location: always say what's happening, and why it didn't work if it didn't.
  function geoDone(label) { geoBtn.disabled = false; geoBtn.classList.remove('is-busy'); geoBtn.innerHTML = label || GEO_LABEL; }
  geoBtn.addEventListener('click', function () {
    state.auto = false;
    if (!navigator.geolocation || !window.isSecureContext) { setStatus('This browser can’t share your location. Pop in your ZIP instead.'); return; }
    geoBtn.disabled = true; geoBtn.classList.add('is-busy');
    geoBtn.innerHTML = '<span class="sb-finder__spin"></span> Finding you…';
    setStatus('<span class="sb-finder__spin"></span> Finding you… If your phone asks, tap <b>Allow</b>.');
    navigator.geolocation.getCurrentPosition(function (p) {
      geoDone('✓ Using your location');
      state.lat = p.coords.latitude; state.lng = p.coords.longitude; state.zip = ''; state.q = ''; state.area = 0; state.place = 'you'; zipEl.value = '';
      state.origin = { lat: state.lat, lng: state.lng };
      search({ scroll: mobile.matches });
    }, function (err) {
      geoDone();
      var msg = err && err.code === 1
        ? 'Location is turned off for this site. Allow it in your browser settings (iPhone: Settings › Privacy & Security › Location Services › Safari Websites), or just pop in your ZIP.'
        : err && err.code === 3 ? 'Finding you took too long. Try again, or pop in your ZIP.'
        : 'We couldn’t find your location. Pop in your ZIP instead.';
      setStatus(msg);
    }, { enableHighAccuracy: false, timeout: 12000, maximumAge: 300000 });
  });
  zipEl.addEventListener('input', function () { if (geoBtn.innerHTML !== GEO_LABEL && !geoBtn.disabled) geoDone(); });

  root.querySelectorAll('.sb-chip[data-flavor]').forEach(function (c) {
    c.addEventListener('click', function () { state.flavor = c.dataset.flavor; group('.sb-chip[data-flavor]', 'flavor', state.flavor); search(); });
  });
  root.querySelectorAll('.sb-seg button[data-type]').forEach(function (b) {
    b.addEventListener('click', function () { state.type = b.dataset.type; group('.sb-seg button[data-type]', 'type', state.type); search(); });
  });
  milesEl.addEventListener('change', function () { state.miles = parseInt(milesEl.value, 10); state.area = 0; search(); });
  mobile.addEventListener('change', function () { if (!mobile.matches) { setView(false); setFull(false); } });

  // Start from the URL (links from the homepage and flavor pages pass zip / lat,lng / flavor)
  if (params.get('flavor')) { state.flavor = params.get('flavor'); group('.sb-chip[data-flavor]', 'flavor', state.flavor); }
  if (/^(on|off)$/.test(params.get('type') || '')) { state.type = params.get('type'); group('.sb-seg button[data-type]', 'type', state.type); }
  if (params.get('miles')) { state.miles = parseInt(params.get('miles'), 10) || 25; milesEl.value = String(state.miles); }
  var startQ = (params.get('q') || params.get('zip') || '').trim();
  if (startQ) { zipEl.value = startQ; lookup(startQ); }
  else if (params.get('lat') && params.get('lng')) { state.lat = parseFloat(params.get('lat')); state.lng = parseFloat(params.get('lng')); state.origin = { lat: state.lat, lng: state.lng }; search(); }
  else {
    // Nothing asked for yet: open on spots near the visitor's approximate city (New York City if unknown)
    var startAt = function (lat, lng, label) {
      if (state.zip || state.q || state.lat !== null) return; // they already searched
      state.auto = true; state.lat = lat; state.lng = lng; state.origin = { lat: lat, lng: lng }; state.place = label;
      search();
    };
    var nyc = function () { startAt(40.7181, -73.9879, 'New York City'); };
    var t = setTimeout(nyc, 2500);
    fetch(API + '/api/where').then(function (r) { return r.json(); }).then(function (w) {
      clearTimeout(t);
      if (isFinite(w.lat) && isFinite(w.lng)) startAt(w.lat, w.lng, w.label || 'you'); else nyc();
    }).catch(function () { clearTimeout(t); nyc(); });
  }
})();
</script>


<script>
(function () {
  /* Desktop mini search bar for Find Us */
  var root = document.getElementById('sb-finder'), bar = root && root.querySelector('[data-sb-mini]');
  if (!bar) return;
  var wide = window.matchMedia('(min-width: 990px)');
  var filters = root.querySelector('.sb-finder__filters'), body = root.querySelector('[data-sb-body]');
  var mainForm = root.querySelector('[data-sb-finder-form]'), mainZip = mainForm.querySelector('[name=zip]');
  var miniForm = bar.querySelector('[data-mini-form]'), miniZip = miniForm.querySelector('[name=zip]');
  var miniMiles = bar.querySelector('[data-mini-miles]'), mainMiles = root.querySelector('[data-sb-miles]');
  function headH() { var h = document.querySelector('.header-wrapper'); return h ? Math.round(h.getBoundingClientRect().bottom) : 0; }
  function sync() {
    bar.querySelectorAll('[data-mini-flavor]').forEach(function (b) {
      var m = root.querySelector('.sb-finder__chips [data-flavor="' + b.dataset.miniFlavor + '"]');
      b.classList.toggle('is-on', !!(m && m.classList.contains('is-on')));
    });
    bar.querySelectorAll('[data-mini-type]').forEach(function (b) {
      var m = root.querySelector('.sb-finder__opts [data-type="' + b.dataset.miniType + '"]');
      b.classList.toggle('is-on', !!(m && m.classList.contains('is-on')));
    });
    miniMiles.value = mainMiles.value;
    if (document.activeElement !== miniZip) miniZip.value = mainZip.value;
  }
  var shown = false;
  function place() {
    var on = false, top = headH();
    if (wide.matches) {
      var f = filters.getBoundingClientRect(), b = body.getBoundingClientRect();
      on = f.bottom < top && b.bottom > top + 160;
    }
    bar.style.top = top + 'px';
    if (on !== shown) {
      shown = on; bar.classList.toggle('is-on', on);
      if (on) { bar.removeAttribute('inert'); bar.removeAttribute('aria-hidden'); sync(); }
      else { bar.setAttribute('inert', ''); bar.setAttribute('aria-hidden', 'true'); }
    }
    document.documentElement.style.setProperty('--sb-mini', on ? bar.offsetHeight + 'px' : '0px');
    document.documentElement.style.setProperty('--sb-head', top + 'px');
  }
  var raf = 0;
  function onScroll() { if (!raf) raf = requestAnimationFrame(function () { raf = 0; place(); }); }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  place();

  miniForm.addEventListener('submit', function (e) {
    e.preventDefault(); mainZip.value = miniZip.value;
    if (mainForm.requestSubmit) mainForm.requestSubmit(); else mainForm.dispatchEvent(new Event('submit', { cancelable: true }));
    miniZip.blur();
  });
  bar.querySelector('[data-mini-geo]').addEventListener('click', function () { var g = root.querySelector('[data-sb-finder-geo]'); if (g) g.click(); });
  bar.addEventListener('click', function (e) {
    var b = e.target.closest('[data-mini-flavor],[data-mini-type]'); if (!b) return;
    var m = b.hasAttribute('data-mini-flavor')
      ? root.querySelector('.sb-finder__chips [data-flavor="' + b.dataset.miniFlavor + '"]')
      : root.querySelector('.sb-finder__opts [data-type="' + b.dataset.miniType + '"]');
    if (m) m.click();
    setTimeout(sync, 0);
  });
  miniMiles.addEventListener('change', function () { mainMiles.value = miniMiles.value; mainMiles.dispatchEvent(new Event('change', { bubbles: true })); });
  new MutationObserver(sync).observe(root.querySelector('.sb-finder__filters'), { subtree: true, attributes: true, attributeFilter: ['class'] });
  mainZip.addEventListener('input', sync); mainMiles.addEventListener('change', sync);
})();
</script>

{% schema %}
{
  "name": "SUNBOY store finder",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme (top)", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Thousands of stores nationwide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find SUNBOY" },
    { "type": "text", "id": "intro", "label": "Before searching", "default": "Pop in your ZIP to see coolers near you." },
    { "type": "text", "id": "note", "label": "Small print", "default": "Stores update as shelves restock. Call ahead to check your flavor is in." },
    { "type": "range", "id": "days", "label": "Show spots that stocked SUNBOY in the last (days)", "min": 14, "max": 90, "step": 1, "default": 60 },
    { "type": "text", "id": "api_base", "label": "Finder service URL", "default": "https://sunboy-finder.vercel.app" },
    { "type": "text", "id": "mapbox_token", "label": "Mapbox public token (optional)", "info": "Leave blank to use the token stored in the finder service (Vercel → MAPBOX_PUBLIC_TOKEN)." }
  ],
  "blocks": [
    { "type": "flavor", "name": "Flavor filter", "settings": [ { "type": "page", "id": "flavor", "label": "Flavor page" } ] }
  ],
  "presets": [ { "name": "SUNBOY store finder" } ]
}
{% endschema %}
