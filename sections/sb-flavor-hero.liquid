{%- comment -%}
  Flavor page hero (only on flavor pages: pages with a SUNBOY hero line).
  Words, colours and nutrition come from the flavor page's SUNBOY metafields.
  Beer is not sold online, so there is no price or add-to-cart: the CTA goes to Find Us.
{%- endcomment -%}
{%- liquid
  comment
    The flavor shown here: a flavor page (Pages, template "flavor") or, as a fallback, a product.
  endcomment
  assign fl = product
  if template.name == 'page'
    assign fl = page
  endif
-%}
{%- if fl.metafields.sunboy.hero_line != blank -%}
{%- liquid
  assign slug = fl.handle | remove_first: 'sunboy-'
  assign mf = fl.metafields.sunboy
  assign c_main = mf.color_main.value | default: '#0BB89B'
  assign c_accent = mf.color_accent.value | default: '#F9ED25'
  assign band = 'sb-band-' | append: slug | append: '.webp'
  assign can = 'sb-can-' | append: slug | append: '.webp'
  assign finder = section.settings.finder_url | default: '/pages/find-us'
-%}
<section class="sb-fhero" style="--flavor-a: {{ c_accent }}; --flavor-b: {{ c_main }};">
  <div class="sb-fhero__stage">
    <span class="sb-fhero__pattern" style="background-image:url('{{ band | asset_url }}')"></span>
    <img class="sb-fhero__can" src="{{ can | asset_url }}" alt="{{ fl.title | escape }} can" width="693" height="1800" fetchpriority="high">
  </div>
  <div class="sb-fhero__text">
    <p class="sb-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="sb-display sb-fhero__name">{{ fl.title }}</h1>
    <p class="sb-fhero__hero">{{ mf.hero_line }}</p>
    {%- if mf.romance != blank -%}<p class="sb-fhero__romance">{{ mf.romance | newline_to_br }}</p>{%- endif -%}
    {%- if mf.tasting_notes != blank or mf.in_the_can != blank or mf.available_in != blank -%}
      <dl class="sb-fhero__facts">
        {%- if mf.tasting_notes != blank -%}<div class="sb-fhero__fact"><dt>Tasting notes</dt><dd>{{ mf.tasting_notes }}</dd></div>{%- endif -%}
        {%- comment -%} Each "·" item stays on one line, so "0g added sugar" never splits into "0g" / "added sugar". {%- endcomment -%}
        {%- if mf.in_the_can != blank -%}{%- assign sb_parts = mf.in_the_can | split: ' · ' -%}<div class="sb-fhero__fact"><dt>In the can</dt><dd>{%- for x in sb_parts -%}<span class="sb-keep">{{ x | strip }}</span>{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}</dd></div>{%- endif -%}
        {%- if mf.available_in != blank -%}{%- assign sb_parts = mf.available_in | split: ' · ' -%}<div class="sb-fhero__fact"><dt>Available in</dt><dd>{%- for x in sb_parts -%}<span class="sb-keep">{{ x | strip | replace: 'Classic Variety 8pk', '<a href="/pages/classic-variety-pack">Classic Variety 8pk</a>' | replace: 'Refresher Variety 8pk', '<a href="/pages/refresher-variety-pack">Refresher Variety 8pk</a>' }}</span>{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}</dd></div>{%- endif -%}
      </dl>
    {%- endif -%}
    {%- if section.settings.badges != blank -%}
      <div class="sb-fhero__badges">
        {%- assign badges = section.settings.badges | split: ',' -%}
        {%- for b in badges -%}<span class="sb-badge">{{ b | strip }}</span>{%- endfor -%}
      </div>
    {%- endif -%}
    <div class="sb-fhero__ctas">
      <a class="sb-btn sb-btn--yellow" href="{{ finder }}?flavor={{ slug }}">Find {{ fl.title | capitalize }} near you</a>
      {%- if mf.nutrition != blank -%}<a class="sb-link-arrow" href="#nutrition">Nutrition facts</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "SUNBOY flavor hero",
  "settings": [
    { "type": "paragraph", "content": "Only shows on flavor pages. Words and colours come from each flavor page's metafields (Online Store → Pages → flavor → Metafields)." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Spiked coconut water · 5% ABV" },
    { "type": "text", "id": "badges", "label": "Badges (comma separated)", "default": "5% ABV, 0g added sugar, Gluten-free, Real coconut water" },
    { "type": "url", "id": "finder_url", "label": "Find Us page" }
  ]
}
{% endschema %}
