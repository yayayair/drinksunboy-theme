{%- comment -%}
  Sabah-style inline signup → your Mailchimp audience (URL set in Theme settings).
{%- endcomment -%}
<section class="color-{{ section.settings.color_scheme }} gradient">
  <div class="sb-wrap sb-news">
    <form class="sb-news__form" data-sb-mc novalidate>
      <div class="sb-mc-form">
        <p class="sb-news__line">{{ section.settings.line }}</p>
        <div class="sb-news__field">
          <label class="visually-hidden" for="sb-news-email-{{ section.id }}">Email</label>
          <input class="sb-news__input" id="sb-news-email-{{ section.id }}" type="email" name="EMAIL" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="email" required>
          <input type="text" tabindex="-1" autocomplete="off" aria-hidden="true" data-sb-mc-hp style="position:absolute;left:-5000px">
          <button class="sb-news__submit" type="submit" aria-label="Sign up">→</button>
        </div>
        <p class="sb-news__fine" data-sb-mc-msg aria-live="polite">{{ section.settings.fine }}</p>
      </div>
      <p class="sb-news__ok sb-mc-done">{{ section.settings.success }}</p>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "SUNBOY newsletter",
  "settings": [
    { "type": "paragraph", "content": "Signups go to your Mailchimp audience (Theme settings → SUNBOY age gate & signup)." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-5" },
    { "type": "text", "id": "line", "label": "Line", "default": "Join the Anti-Hustle Coconut Club for new flavors, merch drops, parties and where to find us:" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "you@sunshine.com" },
    { "type": "text", "id": "fine", "label": "Small print", "default": "Must be 21+. Unsubscribe anytime." },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "You're in. Welcome to the club." }
  ],
  "presets": [ { "name": "SUNBOY newsletter" } ]
}
{% endschema %}
